# Set default behavior to automatically normalize line endings
* text=auto

# Source code files - normalize to LF in repository
*.cpp text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.c text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ttf binary
*.otf binary
*.wav binary
*.ogg binary
*.alife binary
